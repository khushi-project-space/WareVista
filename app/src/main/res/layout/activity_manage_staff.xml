<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginBottom="18dp"

            app:cardBackgroundColor="#B2DFDB"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingStart="14dp"
                android:paddingEnd="14dp">


                <!-- BACK BUTTON -->

                <ImageButton
                    android:id="@+id/btnBack"

                    android:layout_width="38dp"
                    android:layout_height="38dp"

                    android:background="@drawable/back_button_bg"

                    android:contentDescription="Back"

                    android:padding="6dp"

                    android:src="@drawable/ic_back"

                    android:tint="#145A32" />


                <!-- STAFF ICON -->

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"

                    android:layout_marginStart="12dp">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"

                        android:contentDescription="Staff"

                        android:padding="9dp"

                        android:src="@android:drawable/ic_menu_myplaces"

                        android:tint="#145A32" />

                </FrameLayout>


                <!-- TITLE -->

                <LinearLayout

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center_vertical"

                    android:orientation="vertical">

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"

                        android:text="Manage Staff"

                        android:textColor="#145A32"

                        android:textSize="25sp"

                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- SEARCH TITLE -->
        <!-- ===================================================== -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Search Staff"

            android:textColor="#145A32"

            android:textSize="22sp"

            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- SEARCH -->
        <!-- ===================================================== -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="10dp"

            app:cardBackgroundColor="#FFFFFF"

            app:cardCornerRadius="16dp"

            app:cardElevation="3dp"

            app:strokeColor="#D5E5DA"

            app:strokeWidth="1dp">

            <SearchView

                android:id="@+id/searchStaff"

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:background="@android:color/transparent"

                android:iconifiedByDefault="false"

                android:paddingStart="4dp"

                android:paddingEnd="4dp"

                android:queryHint="Search name, ID or mobile..." />

        </com.google.android.material.card.MaterialCardView>


        <!-- ===================================================== -->
        <!-- WAREHOUSE FILTER TITLE -->
        <!-- ===================================================== -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="22dp"

            android:text="Select Warehouse"

            android:textColor="#145A32"

            android:textSize="22sp"

            android:textStyle="bold" />


        <!-- ===================================================== -->
        <!-- WAREHOUSE FILTER -->
        <!-- ===================================================== -->

        <FrameLayout

            android:layout_width="match_parent"
            android:layout_height="56dp"

            android:layout_marginTop="10dp">

            <Spinner

                android:id="@+id/spWarehouseFilter"

                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:background="@drawable/edittext_bg"

                android:paddingStart="16dp"
                android:paddingEnd="16dp"

                android:spinnerMode="dropdown" />

        </FrameLayout>


        <!-- ===================================================== -->
        <!-- STAFF LIST HEADER -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:gravity="center_vertical"

            android:orientation="horizontal">

            <TextView

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Staff Members"

                android:textColor="#145A32"

                android:textSize="22sp"

                android:textStyle="bold" />

            <TextView

                android:id="@+id/txtResultCount"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Showing 0 staff"

                android:textColor="#777777"

                android:textSize="12sp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- LOADING -->
        <!-- ===================================================== -->

        <ProgressBar

            android:id="@+id/progressStaff"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="center_horizontal"

            android:layout_marginTop="18dp"

            android:visibility="gone" />


        <!-- ===================================================== -->
        <!-- EMPTY STATE -->
        <!-- ===================================================== -->

        <TextView

            android:id="@+id/txtEmptyStaff"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="30dp"

            android:gravity="center"

            android:padding="20dp"

            android:text="No staff found"

            android:textColor="#777777"

            android:textSize="17sp"

            android:textStyle="bold"

            android:visibility="gone" />


        <!-- ===================================================== -->
        <!-- STAFF LIST -->
        <!-- ===================================================== -->

        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/recyclerManageStaff"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:nestedScrollingEnabled="false"

            android:clipToPadding="false"

            android:paddingBottom="20dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>