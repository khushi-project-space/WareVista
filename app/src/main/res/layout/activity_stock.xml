<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7F4"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView

            android:layout_width="match_parent"
            android:layout_height="90dp"

            android:layout_marginBottom="18dp"

            app:cardBackgroundColor="#B2DFDB"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:orientation="horizontal"
                android:gravity="center_vertical"

                android:paddingStart="14dp"
                android:paddingEnd="18dp">


                <!-- BACK BUTTON -->

                <ImageView

                    android:id="@+id/btnBack"

                    android:layout_width="38dp"
                    android:layout_height="38dp"

                    android:padding="6dp"

                    android:background="@drawable/back_button_bg"

                    android:src="@drawable/ic_back"

                    app:tint="#145A32"

                    android:scaleType="centerInside"/>


                <!-- LOTTIE -->

                <com.airbnb.lottie.LottieAnimationView

                    android:layout_width="65dp"
                    android:layout_height="65dp"

                    android:layout_marginStart="16dp"

                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/stock"/>


                <!-- TITLE -->

                <TextView

                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"

                    android:text="@string/live_stock_title"

                    android:textSize="26sp"
                    android:textStyle="bold"

                    android:textColor="#145A32"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ===================================================== -->
        <!-- TOP CARDS -->
        <!-- ===================================================== -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:layout_marginTop="22dp">


            <!-- ================================================= -->
            <!-- PURCHASED + SOLD -->
            <!-- ================================================= -->

            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- PURCHASED CARD -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="7dp"
                    app:cardBackgroundColor="#C8E6C9"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- ORIGINAL CONTENT -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/purchased"
                                android:textColor="#145A32"
                                android:textStyle="bold"
                                android:textSize="18sp"/>

                            <TextView
                                android:id="@+id/txtTotalPurchased"
                                android:layout_width="110dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="0 KG"
                                android:textColor="#2E7D32"
                                android:textStyle="bold"
                                android:textSize="30sp"/>

                        </LinearLayout>


                        <!-- FULL CARD SKELETON -->
                        <View
                            android:id="@+id/skeletonPurchased"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#E0E0E0"/>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>
                <!-- ================================================= -->
                <!-- SOLD CARD -->
                <!-- ================================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="7dp"
                    app:cardBackgroundColor="#C8E6C9"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sold"
                                android:textColor="#145A32"
                                android:textStyle="bold"
                                android:textSize="18sp"/>

                            <TextView
                                android:id="@+id/txtTotalSold"
                                android:layout_width="110dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="0 KG"
                                android:textColor="#1565C0"
                                android:textStyle="bold"
                                android:textSize="30sp"/>

                        </LinearLayout>


                        <!-- FULL CARD SKELETON -->
                        <View
                            android:id="@+id/skeletonSold"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#E0E0E0"/>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- AVAILABLE CARD -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="15dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="7dp"
                app:cardBackgroundColor="#C8E6C9"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/available"
                            android:textColor="#145A32"
                            android:textStyle="bold"
                            android:textSize="20sp"/>

                        <TextView
                            android:id="@+id/txtTotalAvailable"
                            android:layout_width="150dp"
                            android:layout_height="45dp"
                            android:gravity="center"
                            android:text="0 KG"
                            android:textColor="#F57F17"
                            android:textStyle="bold"
                            android:textSize="34sp"/>

                    </LinearLayout>


                    <!-- FULL CARD SKELETON -->
                    <View
                        android:id="@+id/skeletonAvailable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#E0E0E0"/>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>


        <!-- ===================================================== -->
        <!-- FILTER -->
        <!-- ===================================================== -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/select_crop"

            android:textSize="22sp"
            android:textStyle="bold"

            android:textColor="#145A32"

            android:layout_marginTop="25dp"/>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp">

            <!-- Actual Spinner -->

            <Spinner
                android:id="@+id/spCrop"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/edittext_bg"
                android:popupBackground="@drawable/spinner_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:spinnerMode="dropdown"/>

            <!-- Spinner Skeleton -->

            <View
                android:id="@+id/skeletonCrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/skeleton_bg"/>

        </FrameLayout>

        <!-- ===================================================== -->
        <!-- STOCK LIST -->
        <!-- ===================================================== -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/crop_stock"

            android:textSize="22sp"
            android:textStyle="bold"

            android:textColor="#145A32"

            android:layout_marginTop="22dp"/>


        <androidx.recyclerview.widget.RecyclerView

            android:id="@+id/recyclerStock"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <TextView

            android:id="@+id/txtNoStock"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="@string/stock_not_available_display"
            android:textSize="18sp"

            android:textStyle="bold"

            android:gravity="center"

            android:textColor="#D32F2F"

            android:padding="20dp"

            android:visibility="gone"/>


        <!-- ===================================================== -->
        <!-- INSIGHTS -->
        <!-- ===================================================== -->

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/stock_insights"

            android:textSize="22sp"

            android:textStyle="bold"

            android:textColor="#145A32"

            android:layout_marginTop="25dp"/>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/highlightCard"

            android:layout_width="match_parent"
            android:layout_height="190dp"

            android:layout_marginTop="12dp"

            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"

            app:strokeColor="#A5D6A7"
            app:strokeWidth="1dp"

            app:cardBackgroundColor="#E8F5E9">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ============================= -->
                <!-- ORIGINAL INSIGHTS CONTENT -->
                <!-- ============================= -->

                <LinearLayout
                    android:id="@+id/highlightContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtHighlightIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆"
                        android:textSize="42sp"/>

                    <TextView
                        android:id="@+id/txtHighlightTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/highest_stock"
                        android:textColor="#145A32"
                        android:textStyle="bold"
                        android:textSize="21sp"/>

                    <TextView
                        android:id="@+id/txtHighlightValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="0"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/live_stock_analysis"
                        android:textColor="#66BB6A"
                        android:textSize="14sp"/>

                </LinearLayout>


                <!-- ============================= -->
                <!-- FULL INSIGHTS SKELETON -->
                <!-- ============================= -->

                <LinearLayout
                    android:id="@+id/skeletonHighlight"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="#E0E0E0">

                    <!-- Icon -->

                    <View
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/skeleton_circle"/>

                    <!-- Title -->

                    <View
                        android:layout_width="150dp"
                        android:layout_height="22dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/skeleton_bg"/>

                    <!-- Value -->

                    <View
                        android:layout_width="180dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/skeleton_bg"/>

                    <!-- Bottom text -->

                    <View
                        android:layout_width="130dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/skeleton_bg"/>

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>