<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E7F3EA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WareVista"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#145A32"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment"
            android:textSize="18sp"
            android:textColor="#555555"
            android:layout_marginTop="4dp" />

        <!-- QR Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="5dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan QR to Pay"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="15dp" />

                <!-- QR Image -->
                <ImageView
                    android:id="@+id/imgQR"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:contentDescription="Payment QR Code"
                    android:background="#FFFFFF" />

                <!-- Amount -->
                <TextView
                    android:id="@+id/txtQRAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount to Pay : ₹0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#145A32"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan the QR code and complete the payment."
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Payment Done -->
        <Button
            android:id="@+id/btnPaymentDone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="I HAVE PAID"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="5dp" />

        <!-- Cancel -->
        <Button
            android:id="@+id/btnCancelQR"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="CANCEL"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:backgroundTint="#DDDDDD"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>