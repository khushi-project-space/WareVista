        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWarehouseCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp">

            <!-- ============================= -->
            <!-- LOADING -->
            <!-- ============================= -->

            <FrameLayout
                android:id="@+id/layoutSubscriptionLoading"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/progressSubscription"
                    android:layout_width="36dp"
                    android:layout_height="36dp" />

            </FrameLayout>


            <!-- ============================= -->
            <!-- WAREHOUSE CONTENT -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/layoutWarehouseContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Warehouses"
                    android:textColor="#145A32"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWarehouseInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Select number of warehouses"
                    android:textColor="#557064"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinus"
                        android:layout_width="55dp"
                        android:layout_height="50dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="#145A32"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:backgroundTint="#E0E0E0"
                        app:cornerRadius="15dp"
                        app:strokeWidth="0dp" />

                    <TextView
                        android:id="@+id/txtWarehouseCount"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="#F1F8F4"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#145A32"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlus"
                        android:layout_width="55dp"
                        android:layout_height="50dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="15dp"
                        app:strokeWidth="0dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================== -->
        <!-- DURATION -->
        <!-- ============================================== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Subscription Duration"
            android:textColor="#145A32"
            android:textSize="20sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbMonthly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Monthly"
                android:textColor="#163A27"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rbYearly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="Yearly"
                android:textColor="#163A27"
                android:textSize="16sp" />

        </RadioGroup>


        <!-- ============================================== -->
        <!-- PRICE -->
        <!-- ============================================== -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#145A32"
            app:cardCornerRadius="22dp"
            app:cardElevation="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subscription Amount"
                    android:textColor="#D8F3E3"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="₹0"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPriceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Select a subscription plan"
                    android:textColor="#D8F3E3"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ============================================== -->
        <!-- CONTINUE -->
        <!-- ============================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubscribe"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="20dp"
            android:text="Continue"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#2E7D32"
            app:cornerRadius="18dp" />

    </LinearLayout>

</ScrollView>