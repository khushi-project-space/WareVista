<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"


    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:gravity="center"

    android:background="#DDEFE5">


    <androidx.cardview.widget.CardView

        android:layout_width="330dp"
        android:layout_height="400dp"

        app:cardCornerRadius="35dp"
        app:cardElevation="10dp"
        app:cardBackgroundColor="#FFFFFF">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"

            android:gravity="center"

            android:padding="25dp">



            <com.airbnb.lottie.LottieAnimationView

                android:id="@+id/lottieSuccess"

                android:layout_width="180dp"

                android:layout_height="180dp"


                app:lottie_autoPlay="true"

                app:lottie_loop="false"

                app:lottie_rawRes="@raw/warehouse_success"/>



<!--            <TextView-->

<!--                android:id="@+id/txtMessage"-->

<!--                android:layout_width="wrap_content"-->

<!--                android:layout_height="wrap_content"-->


<!--                android:layout_marginTop="25dp"-->


<!--                android:text="Purchase Saved Successfully"-->


<!--                android:textColor="#145A32"-->

<!--                android:textSize="22sp"-->

<!--                android:textStyle="bold"/>-->
            <TextView

                android:id="@+id/txtMessage"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:layout_marginTop="25dp"

                android:gravity="center"

                android:singleLine="true"

                android:ellipsize="none"

                android:text="Purchase Saved Successfully"

                android:textColor="#145A32"

                android:textSize="20sp"

                android:textStyle="bold"/>



            <TextView

                android:id="@+id/txtSubMessage"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"


                android:layout_marginTop="10dp"


                android:text="Inventory Updated Successfully"


                android:textColor="#666666"

                android:textSize="16sp"/>



            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"


                android:layout_marginTop="25dp"


                android:text="🌾 WareVista"

                android:textColor="#145A32"

                android:textStyle="bold"

                android:textSize="18sp"/>


        </LinearLayout>


    </androidx.cardview.widget.CardView>


</LinearLayout>