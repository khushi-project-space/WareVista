<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"

    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#D5E5DA"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP ROW -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtStaffName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Staff Name"
                android:textColor="#145A32"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="STAFF"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- STAFF ID -->

        <TextView
            android:id="@+id/txtStaffId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="ID: staff001"
            android:textColor="#555555"
            android:textSize="14sp" />


        <!-- WAREHOUSE -->

        <TextView
            android:id="@+id/txtWarehouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Warehouse: Surat"
            android:textColor="#555555"
            android:textSize="14sp" />


        <!-- MOBILE -->

        <TextView
            android:id="@+id/txtMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Mobile: 9876543210"
            android:textColor="#555555"
            android:textSize="14sp" />


        <!-- CREATE DATE -->

        <TextView
            android:id="@+id/txtCreateDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Created: 20/08/2026"
            android:textColor="#777777"
            android:textSize="13sp" />


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E5E5E5" />


        <!-- ACTIONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnEditStaff"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_bg"
                android:contentDescription="Edit Staff"
                android:padding="11dp"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#2E7D32" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/btnDeleteStaff"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/circle_bg"
                android:contentDescription="Delete Staff"
                android:padding="11dp"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#C62828" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>