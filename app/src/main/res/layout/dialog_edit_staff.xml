<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etEditStaffName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Staff Name"
            android:inputType="textPersonName"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEditStaffId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Staff ID"
            android:inputType="text"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEditPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="New Password (optional)"
            android:inputType="textPassword"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEditWarehouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Warehouse / City"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEditMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Mobile Number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEditCreateDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Create Date"
            android:inputType="text"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>